# Optional. Enables the "Review this run" button. Without it the app works; reviews are disabled.
ANTHROPIC_API_KEY=

# Model used for reviews. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: low | medium | high | xhigh | max. Leave empty for the model default.
ANTHROPIC_EFFORT=

# Server-side refusal fallback (fallbacks: "default"). Set to "off" for models that do not support it.
ANTHROPIC_FALLBACKS=
